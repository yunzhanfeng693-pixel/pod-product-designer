{
  "name": "x-team-tshirt-designer",
  "version": "1.1.2",
  "description": "POD产品设计器",
  "author": "lufan",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "tsc && vite build && electron-builder",
    "desktop": "npm run build && electron .",
    "start": "npm run desktop"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "playwright": "^1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.xteam.designer",
    "productName": "POD产品设计器",
    "directories": {
      "output": "dist-electron"
    },
    "asarUnpack": [
      "electron/doubao-relay/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "extraResources": [
      {
        "from": "C:\\Program Files\\nodejs\\node.exe",
        "to": "runtime/node.exe"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
